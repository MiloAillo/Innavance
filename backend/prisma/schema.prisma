// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// admin sides
model Admin {
  id                              Int                      @id @default(autoincrement())
  isAutoApprove                   Boolean
  autoApproveTime                 Int
  smartDoorDefaultPin             Int
  checkOutGracePeriod             Int                      @default(60)
  isStaffAllowedToApprove         Boolean                  @default(true)
  isStaffAllowedToForceCheckout   Boolean                  @default(false)
  isStaffAllowedToDismissCall     Boolean               @default(true)

  notifications         AdminNotifications[]
  users                 AdminUsers[]
}

model AdminUsers {
  id              Int                         @id @default(autoincrement())
  admin_id        Int
  type            AdminUsersType              @default(staff)
  name            String @db.VarChar(255)
  username        String @db.VarChar(50)      @unique
  password        String @db.VarChar(255)
  refreshToken    String? @db.VarChar(255)    @unique
  createdAt       DateTime                    @default(now())

  userAdmin       Admin                       @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("Admin_Users")
}

enum AdminUsersType {
  manager
  staff
}

model AdminNotifications {
  id                  Int                         @id @default(autoincrement())
  admin_id            Int
  type                AdminNotificationsType      @default(info)
  title               String @db.VarChar(255)
  description         String @db.VarChar(500)
  createdAt           DateTime                    @default(now())

  notificationAdmin   Admin                       @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("Admin_Notifications")
}

enum AdminNotificationsType {
  info
  warning
  important
}

// user sides
model Rooms {
  id                  Int                       @id @default(autoincrement())
  accountId           String? @db.VarChar(225)  @unique
  name                String @db.VarChar(225)
  price               Int
  capacity            Int
  description         String @db.Text
  isAvailable         Boolean                   @default(true)
  smartDoorPin        Int                       @default(157359)
  smartDoorIsLocked   Boolean
  smartDoorIsOpened   Boolean
  electricityOutput   Float
  waterOutput         Float

  features            RoomsFeatures[]
  roomsAddons         RoomsAddons[]
  bookings            Bookings[]
}

model Addons {
  id              Int                       @id @default(autoincrement())
  addon           String @db.VarChar(50)    
  price           Int
  borrowMaximum   Int

  roomsAddons     RoomsAddons[]
  bookingsAddons  BookingsAddons[]
}

model RoomsAddons {
  room_id     Int
  addon_id    Int

  room        Rooms     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  addon       Addons    @relation(fields: [addon_id], references: [id], onDelete: Cascade)
  @@id([room_id, addon_id])

  @@map("Rooms_Addons")
}

model RoomsFeatures {
  id            Int                         @id @default(autoincrement())
  room_id       Int
  feature       String @db.VarChar(500)

  featureRoom   Rooms                       @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@map("Rooms_Features")
}

model Bookings {
  id                      Int                         @id @default(autoincrement())
  room_id                 Int
  status                  BookingsStatus
  name                    String @db.VarChar(255)
  phoneNumber             String @db.VarChar(25)
  duration                Int
  price                   Int
  paymentMethod           String @db.VarChar(100)
  isAddonServed           Boolean
  isInnkeeperCalled       Boolean
  isAutoApprove           Boolean                  @default(false)
  checkoutGraceTime       Int?
  autoApproveTime         Int?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime?                   @updatedAt
  checkedInAt             DateTime?

  bookingRoom             Rooms                       @relation(fields: [room_id], references: [id], onDelete: Cascade)
  bookingsAddons          BookingsAddons[]
  bookingsNotifications   BookingsNotifications[]
}

enum BookingsStatus {
  on_hold
  rejected
  checked_in
  checking_out
  checked_out
}

model BookingsAddons {
  booking_id      Int
  addon_id        Int  
  count           Int

  addonBooking    Bookings                  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  addonAddon      Addons                    @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@id([booking_id, addon_id])

  @@map("Bookings_Addons")
}

model BookingsNotifications {
  id                    Int                             @id @default(autoincrement())
  booking_id            Int
  type                  BookingsNotificationsType       @default(info)
  title                 String @db.VarChar(255)
  description           String @db.VarChar(500)
  createdAt             DateTime                        @default(now())

  notificationBooking   Bookings                        @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("Bookings_Notifications")
}

enum BookingsNotificationsType {
  info
  warning
  important
}